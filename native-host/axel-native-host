#!/usr/bin/env python3
import sys
import os
import json
import struct
import subprocess
import shutil

def get_message():
    raw_length = sys.stdin.buffer.read(4)
    if not raw_length:
        return None
    message_length = struct.unpack('@I', raw_length)[0]
    message = sys.stdin.buffer.read(message_length).decode('utf-8')
    return json.loads(message)

def send_message(msg):
    encoded = json.dumps(msg).encode('utf-8')
    sys.stdout.buffer.write(struct.pack('@I', len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()

def main():
    msg = get_message()
    if not msg:
        sys.exit(0)

    gui_path = "/usr/bin/axel-gui"
    if not os.path.exists(gui_path):
        gui_path = shutil.which("axel-gui")

    if not gui_path or not os.path.exists(gui_path):
        send_message({"error": "not_installed"})
        sys.exit(0)

    url = msg.get("url", "").strip()
    filename = msg.get("filename", "").strip()
    cookie = msg.get("cookie", "").strip()
    user_agent = msg.get("userAgent", "").strip()
    referer = msg.get("referer", "").strip()

    if url:
        cmd = [gui_path, "--url", url]
        if filename:
            cmd.extend(["--filename", os.path.basename(filename)])
        if cookie:
            cmd.extend(["--cookie", cookie])
        if user_agent:
            cmd.extend(["--user-agent", user_agent])
        if referer:
            cmd.extend(["--referer", referer])

        cmd.append("--autostart")

        subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True
        )
        send_message({"status": "started"})

if __name__ == "__main__":
    main()
