{
    "manifest_version": 2,
    "name": "Axel GUI Integration",
    "version": "1.2",
    "description": "Intercepts downloads and sends them directly to Axel GUI",
    "browser_specific_settings": {
        "gecko": {
            "id": "axel-gui-downloader@sourav.dev"
        }
    },
    "permissions": [
        "downloads",
        "nativeMessaging",
        "captivePortal",
        "cookies",
        "notifications",
        "tabs",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
