{
    "manifest_version": 2,
    "name": "Axel GUI Integration",
    "version": "1.1",
    "description": "Intercepts downloads and sends them directly to Axel GUI",
    "browser_specific_settings": {
        "gecko": {
            "id": "axel-gui-downloader@sourav.dev",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "permissions": [
        "downloads",
        "nativeMessaging",
        "captivePortal",
        "cookies",
        "<all_urls>"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
