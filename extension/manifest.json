{
    "manifest_version": 2,
    "name": "Axel GUI Integration",
    "version": "1.0",
    "description": "Intercepts downloads and sends them directly to Axel GUI",
    "browser_specific_settings": {
        "gecko": {
            "id": "axel-gui-downloader@sourav.dev"
        }
    },
    "permissions": [
        "downloads",
        "nativeMessaging"
    ],
    "background": {
        "scripts": [
            "background.js"
        ]
    }
}
